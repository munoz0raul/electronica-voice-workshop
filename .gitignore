__pycache__/

# pruned upstream material kept locally only (never pushed)
.trash/

# OCI images
/images/

# temp dirs for builds and update-server targets
build/
targets/

# checkout of sdk-tools w/ patches
apps/qip-gesture/sdk-tools/

# wifi.conf is now committed — all boards must be built with the same PSK so
# they connect to each other out of the box.  build-os.sh only generates it
# when it is missing, so the committed file takes precedence.

# build output and test logs for tools (cargo target dirs)
tools/*/target/
apps/*/target/
lib/*/target/

# MCU firmware built by build-zephyr.sh --copy-to-recipe
meta-demo/recipes-bsp/zephyr-firmware/files/*.elf
