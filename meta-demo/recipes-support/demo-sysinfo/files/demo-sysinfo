#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""fioconfig remote action: print what the device runs, as one JSON object:
os-release, the kernel, the firmware capsule version (UEFI ESRT), each
Qualcomm firmware image's build and the MCU firmware.

The dashboard triggers it (a fioconfig-oneshot-demo-sysinfo device config)
and reads the output from the device's test results. It runs on the host,
so it sees /sys/firmware, which Docker hides from containers.
"""
import glob
import hashlib
import json
import os
import re


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def os_release():
    out = {}
    for line in (read("/etc/os-release") or "").splitlines():
        key, sep, value = line.partition("=")
        if sep:
            out[key] = value.strip().strip("\"'")
    return out


def esrt():
    """The UEFI firmware resources: capsule-updatable firmware versions."""
    out = []
    for entry in sorted(glob.glob("/sys/firmware/efi/esrt/entries/*")):
        version = read(f"{entry}/fw_version")
        out.append({
            "class": read(f"{entry}/fw_class"),
            "version": int(version) if version and version.isdigit() else version,
            "last_attempt_status": read(f"{entry}/last_attempt_status"),
        })
    return out


def images():
    """Each Qualcomm firmware image's build string, as the boot firmware
    reports it in SMEM (socinfo): boot, tz, the DSPs, the modem and so on.
    Needs debugfs; empty without it."""
    out = {}
    for path in sorted(glob.glob("/sys/kernel/debug/qcom_socinfo/*/name")):
        name = (read(path) or "").replace("\0", "").strip()
        # "00:BOOT.MXF.1.0.c1-00569-KODIAKLA-1": drop the image index
        name = re.sub(r"^\d+:", "", name)
        name = name.removeprefix("QC_IMAGE_VERSION_STRING=")
        if name:
            out[path.split("/")[-2]] = name
    return out


def mcu():
    """The Zephyr firmware the image loads into the MCU at boot."""
    out = []
    for path in sorted(glob.glob("/usr/lib/firmware/zephyr-*.elf")):
        with open(path, "rb") as f:
            data = f.read()
        build = re.search(rb"Zephyr OS build ([\w.+-]+)", data)
        out.append({
            "file": os.path.basename(path),
            "sha256": hashlib.sha256(data).hexdigest(),
            "zephyr": build.group(1).decode() if build else None,
        })
    return out


u = os.uname()
print(json.dumps({
    "os": os_release(),
    "kernel": {"release": u.release, "version": u.version},
    "uefi": esrt(),
    "images": images(),
    "mcu": mcu(),
    "model": (read("/sys/firmware/devicetree/base/model") or "").rstrip("\0") or None,
}))
