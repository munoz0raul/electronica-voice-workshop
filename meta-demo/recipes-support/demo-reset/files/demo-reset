"""fioconfig remote action: let the demo's reset install an earlier update.

Every update's TUF metadata is signed once, at upload, so a device that has
taken a later update rejects an earlier one's metadata as a rollback attack.
This deletes aktualizr-lite's stored snapshot, targets and timestamp
metadata (repo 0, types 1-3) and keeps root, so the next check verifies the
assigned update's metadata against the same root without the version
comparison. The dashboard runs it only after a reset has assigned the
earlier update: run sooner, the device would fetch and trust its current,
later metadata again.
"""
import json
import sqlite3
import subprocess

DB = "/var/sota/sql.db"

subprocess.run(["systemctl", "stop", "aktualizr-lite"], check=True)
try:
    db = sqlite3.connect(DB)
    cleared = db.execute("DELETE FROM meta WHERE repo = 0 AND meta_type IN (1, 2, 3)").rowcount
    db.commit()
    kept = [{"repo": r, "type": t, "version": v} for r, t, v in db.execute("SELECT repo, meta_type, version FROM meta")]
    db.close()
finally:
    subprocess.run(["systemctl", "start", "aktualizr-lite"], check=True)
print(json.dumps({"cleared": cleared, "kept": kept}))
